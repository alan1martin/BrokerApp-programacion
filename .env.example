# Django Generales
SECRET_KEY=CAMBIAR_POR_UNA_CADENA_LARGA_Y_SECRETA_EN_PRODUCCION
DEBUG=False
DJANGO_ALLOWED_HOSTS=api.app4.academia.ar,localhost,127.0.0.1

# Token JWT (Firma de seguridad para Simple JWT)
JWT_SECRET_KEY=OTRA_CADENA_COMPLETAMENTE_DIFERENTE_Y_SECRETA

# Superusuario inicial opcional para Docker
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=CAMBIAR_PASSWORD_SUPERUSUARIO
DJANGO_SUPERUSER_EMAIL=admin@academia.ar

# Base de Datos (PostgreSQL en Docker)
POSTGRES_DB=app4_db
