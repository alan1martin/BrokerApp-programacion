POSTGRES_PASSWORD=PASSWORD_SEGURO_POSTGRES

# URL de Base de datos (inyectada en Docker o para desarrollo remoto)
DATABASE_URL=postgres://app4_user:PASSWORD_SEGURO_POSTGRES@db:5432/app4_db
